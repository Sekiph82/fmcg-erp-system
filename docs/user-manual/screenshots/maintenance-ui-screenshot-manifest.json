{
  "module": "maintenance",
  "route": "/dashboard/maintenance",
  "screenshots": [
    {
      "id": "overview-tab",
      "path": "module-ui/maintenance/overview/overview-tab.png",
      "description": "Maintenance overview dashboard — KPI tiles, open breakdowns panel, overdue PMs panel, quick links",
      "steps": [
        { "type": "goto", "url": "/dashboard/maintenance?tab=overview" },
        { "type": "wait", "ms": 2000 }
      ]
    },
    {
      "id": "assets-tab",
      "path": "module-ui/maintenance/assets/assets-tab.png",
      "description": "Asset register — full asset list with status badges",
      "steps": [
        { "type": "goto", "url": "/dashboard/maintenance?tab=assets" },
        { "type": "wait", "ms": 2000 }
      ]
    },
    {
      "id": "new-asset-modal",
      "path": "module-ui/maintenance/assets/new-asset-modal.png",
      "description": "Add Asset modal — full form with dropdowns expanded",
      "steps": [
        { "type": "goto", "url": "/dashboard/maintenance?tab=assets" },
        { "type": "wait", "ms": 1500 },
        { "type": "clickRole", "role": "button", "name": "Add Asset" },
        { "type": "wait", "ms": 800 },
        { "type": "evaluate", "script": "document.querySelectorAll('select').forEach(s => { if(s.options.length > 1){ s.size = s.options.length; s.style.height='auto'; s.style.overflow='visible'; } })" }
      ]
    },
    {
      "id": "breakdowns-tab",
