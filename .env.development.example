# Local development environment. Copy to .env.development.

ENVIRONMENT=development
PROJECT_NAME=FMCG ERP

POSTGRES_USER=erp_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fmcg_erp
DATABASE_URL=postgresql+asyncpg://erp_user:changeme@db:5432/fmcg_erp
REDIS_URL=redis://redis:6379/0

SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

AUTO_CREATE_TABLES=false
RUN_MIGRATIONS_ON_STARTUP=false

SEED_INITIAL_ADMIN=true
SEED_DEMO_DATA=true
SYNC_INITIAL_ADMIN_PASSWORD=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@erp.local
INITIAL_ADMIN_PASSWORD=Admin1234!
INITIAL_ADMIN_FULL_NAME=System Administrator
DEMO_USER_PASSWORD=Demo1234!

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_RETURN_TOKEN_IN_BODY=false
ERROR_TRACKING_DSN=

NEXT_PUBLIC_API_URL=http://localhost:8000

# ── 2FA OTP Delivery ──────────────────────────────────────────────────────────
# OTP_DEV_DELIVERY_MODE=true logs OTPs to the backend console (watch docker logs).
# NOT allowed in production. Set to false and configure SMTP/SMS for real delivery.
TWO_FACTOR_EMAIL_ENABLED=true
TWO_FACTOR_SMS_ENABLED=false
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DEV_DELIVERY_MODE=true

# SMTP — leave blank to use dev delivery mode locally
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@erp.local
SMTP_USE_TLS=true

# SMS (Twilio) — leave blank to use dev delivery mode locally
SMS_PROVIDER=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_SENDER_ID=

# ── AI Provider ──────────────────────────────────────────────────────────────
# Mock mode is fine for local dev. To test live AI locally, set one key below.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3
AI_NL_COMMAND_EXECUTION_ENABLED=false
