# Copy to .env and fill in values.
# For local development, copy .env.development instead.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fmcg_erp

# ── Backend ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── AI Provider ───────────────────────────────────────────────────────────────
# AI_PROVIDER=auto means the system detects which key you filled in.
# Just fill in ONE of the API keys below — leave the others blank.
# Priority if multiple keys present: Anthropic → OpenAI → Gemini
AI_PROVIDER=auto             # auto | anthropic | openai | gemini | mock

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (GPT-4o) — https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3
