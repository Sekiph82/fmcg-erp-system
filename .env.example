# Generic env template — kept for reference only.
# For Docker development use .env.development.example instead:
#   copy .env.development.example .env.development
#
# This file uses localhost:5432 / localhost:6379 (direct host access).
# .env.development.example uses db:5432 / redis:6379 (Docker service names).
# Do not use this file directly with docker compose --env-file.

ENVIRONMENT=development
PROJECT_NAME=FMCG ERP

POSTGRES_USER=erp_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fmcg_erp
DATABASE_URL=postgresql+asyncpg://erp_user:changeme@localhost:5432/fmcg_erp
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

AUTO_CREATE_TABLES=false
RUN_MIGRATIONS_ON_STARTUP=false

SEED_INITIAL_ADMIN=true
SEED_DEMO_DATA=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@erp.local
INITIAL_ADMIN_PASSWORD=change-me-dev-admin123
INITIAL_ADMIN_FULL_NAME=System Administrator
DEMO_USER_PASSWORD=change-me-dev-demo123

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_RETURN_TOKEN_IN_BODY=false
ERROR_TRACKING_DSN=

NEXT_PUBLIC_API_URL=http://localhost:8000

AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3
AI_NL_COMMAND_EXECUTION_ENABLED=false
