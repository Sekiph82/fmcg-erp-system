{
  "name": "fmcg-erp-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test:auth-refresh": "node --test tests/unit/api-auth-refresh.test.mjs",
    "manual:screenshots": "node scripts/capture-user-manual-screenshots.mjs",
    "manual:validate-routes": "node scripts/validate-manual-routes.mjs",
    "check:api-parity": "node scripts/check-api-parity.mjs",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test e2e/smoke.spec.ts",
    "test:developer-portal": "playwright test e2e/developer-portal-errors.spec.ts --project=chromium --no-deps",
    "test:m20-responsive": "playwright test e2e/m20-responsive-dashboard.spec.ts --project=chromium --no-deps",
    "test:manual-screenshots": "playwright test e2e/manual-screenshots.spec.ts --project=chromium",
    "test:manual-screenshots:failed": "playwright test e2e/manual-screenshots.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "audit:pages": "node ../scripts/audit-page-count.js",
    "audit:redirects": "node ../scripts/check-route-redirects.js",
    "audit:workspace-tabs": "node ../scripts/check-workspace-tabs.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.35.1",
    "axios": "^1.6.8",
    "clsx": "^2.1.1",
    "next": "16.4.2",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "marked": "^18.0.3",
    "playwright": "^1.59.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
