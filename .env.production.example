# Production environment template.
# Copy to .env.production and fill in ALL values before deploying.
#
# Usage:
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up --build -d
#
# WARNING: All placeholder values below MUST be changed before production use.
# Leaving any CHANGE_ME value will cause startup to fail (production guards are enforced).

ENVIRONMENT=production
PROJECT_NAME=FMCG ERP

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=fmcg_erp
DATABASE_URL=postgresql+asyncpg://erp_user:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/fmcg_erp
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
# Redis AUTH password — required in production. Use a strong random value.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Do not commit real production value.
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_CHAR_HEX_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["https://yourdomain.example.com"]

AUTO_CREATE_TABLES=false
RUN_MIGRATIONS_ON_STARTUP=false

# ── Seeding ────────────────────────────────────────────────────────────────────
# Set SEED_INITIAL_ADMIN=true only on first deployment to create the initial admin.
# Set to false after the first successful login to prevent accidental re-seeding.
SEED_INITIAL_ADMIN=false
SEED_DEMO_DATA=false
# SYNC_INITIAL_ADMIN_PASSWORD must be false in production — auto-syncing admin
# passwords from env is a development-only feature. Production startup rejects true.
SYNC_INITIAL_ADMIN_PASSWORD=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@yourdomain.example.com
# Use a strong unique password. This is only used when creating the initial admin.
# Never use Admin1234! or any default password in production.
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
INITIAL_ADMIN_FULL_NAME=System Administrator
DEMO_USER_PASSWORD=

# ── Management user seed (optional — disabled by default) ─────────────────────
# Set ERP_SEED_MANAGEMENT_USERS=true on first deployment to create top management accounts.
# Set to false after the first successful deploy to prevent accidental re-seeding.
# Only users with both EMAIL and PASSWORD set will be created.
# Passwords starting with CHANGE_ME will cause startup to fail (production guard).
# Do NOT commit this file with real passwords — use a secret manager or real .env.production.
# CTO is the technical management role — no separate technical_manager role exists.
ERP_SEED_MANAGEMENT_USERS=false
ERP_FORCE_PASSWORD_CHANGE_ON_FIRST_LOGIN=true
ERP_ADMIN_EMAIL=
ERP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ERP_ADMIN_FULL_NAME=System Administrator
ERP_CEO_EMAIL=
ERP_CEO_PASSWORD=CHANGE_ME_CEO_PASSWORD
ERP_CEO_FULL_NAME=Chief Executive Officer
ERP_CTO_EMAIL=
ERP_CTO_PASSWORD=CHANGE_ME_CTO_PASSWORD
ERP_CTO_FULL_NAME=Chief Technology Officer
ERP_CMO_EMAIL=
ERP_CMO_PASSWORD=CHANGE_ME_CMO_PASSWORD
ERP_CMO_FULL_NAME=Chief Marketing Officer
ERP_COO_EMAIL=
ERP_COO_PASSWORD=CHANGE_ME_COO_PASSWORD
ERP_COO_FULL_NAME=Chief Operating Officer
ERP_CFO_EMAIL=
ERP_CFO_PASSWORD=CHANGE_ME_CFO_PASSWORD
ERP_CFO_FULL_NAME=Chief Financial Officer

# ── Auth cookies ───────────────────────────────────────────────────────────────
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_RETURN_TOKEN_IN_BODY=false
REQUEST_TIMEOUT_SECONDS=60
ERROR_TRACKING_DSN=

# ── Password policy (production enforces all) ──────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://yourdomain.example.com

# ── 2FA OTP Delivery ───────────────────────────────────────────────────────────
# OTP_DEV_DELIVERY_MODE MUST be false in production — startup rejects true.
TWO_FACTOR_EMAIL_ENABLED=true
TWO_FACTOR_SMS_ENABLED=false
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DEV_DELIVERY_MODE=false

# ── SMTP (email OTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.yourdomain.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@yourdomain.example.com
SMTP_USE_TLS=true

# ── SMS OTP (Twilio) — set TWO_FACTOR_SMS_ENABLED=true to activate ─────────────
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=CHANGE_ME_TWILIO_ACCOUNT_SID
SMS_AUTH_TOKEN=CHANGE_ME_TWILIO_AUTH_TOKEN
SMS_SENDER_ID=CHANGE_ME_TWILIO_FROM_NUMBER

# ── M-Pesa / Safaricom Daraja ────────────────────────────────────────────────
# Required for live STK Push payments. Obtain credentials from Safaricom Daraja portal.
# Test in sandbox first (MPESA_ENV=sandbox), then switch to production.
# MPESA_CALLBACK_URL must be a public HTTPS URL reachable by Safaricom servers.
MPESA_ENV=production
MPESA_CONSUMER_KEY=CHANGE_ME_DARAJA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=CHANGE_ME_DARAJA_CONSUMER_SECRET
MPESA_SHORTCODE=CHANGE_ME_PAYBILL_OR_TILL_NUMBER
MPESA_PASSKEY=CHANGE_ME_STK_PUSH_PASSKEY
MPESA_CALLBACK_URL=https://yourdomain.example.com/api/v1/integrations/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# ── KRA eTIMS (Kenya e-Invoice) ───────────────────────────────────────────────
# WARNING: Final provider/middleware/VSCU/OSCU details must be confirmed.
# Do NOT use in production until KRA sandbox/provider validation is complete.
# Connector-ready skeleton only — live provider is not yet finalized.
ETIMS_PROVIDER=simulation
ETIMS_API_URL=
ETIMS_SALES_SUBMIT_PATH=/api/method/saveSales
ETIMS_PIN=CHANGE_ME_KRA_TAXPAYER_PIN
ETIMS_BRANCH_ID=CHANGE_ME_BRANCH_ID
ETIMS_DEVICE_SERIAL_NO=CHANGE_ME_DEVICE_SERIAL_NO
ETIMS_ENV=sandbox

# ── AI Provider ────────────────────────────────────────────────────────────────
# To enable live AI (predictions, formulations, recommendations, chat, copilot):
#   Set at least one API key below and restart the backend.
#   AI_PROVIDER=auto detects whichever key is present (Anthropic → OpenAI → Gemini).
#   Without any key the backend falls back to mock/demo mode — no real LLM calls.
# Recommended: Anthropic (Claude). Obtain key at https://console.anthropic.com
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3
AI_NL_COMMAND_EXECUTION_ENABLED=false
