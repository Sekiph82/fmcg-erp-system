ENVIRONMENT=production
PROJECT_NAME=FMCG ERP

POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=fmcg_erp
DATABASE_URL=postgresql+asyncpg://erp_user:CHANGE_ME_STRONG_PASSWORD@db:5432/fmcg_erp
REDIS_URL=redis://redis:6379/0

SECRET_KEY=CHANGE_ME_RANDOM_64_CHAR_HEX
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["https://yourdomain.com"]
PASSWORD_REQUIRE_SPECIAL=true

AUTO_CREATE_TABLES=false
RUN_MIGRATIONS_ON_STARTUP=false

SEED_INITIAL_ADMIN=true
SEED_DEMO_DATA=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
INITIAL_ADMIN_FULL_NAME=System Administrator
DEMO_USER_PASSWORD=

AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_RETURN_TOKEN_IN_BODY=false

NEXT_PUBLIC_API_URL=https://api.yourdomain.com

AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3
AI_NL_COMMAND_EXECUTION_ENABLED=false
