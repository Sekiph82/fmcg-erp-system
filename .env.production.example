# Production environment template.
# Copy to .env.production and fill in ALL values before deploying.
#
# Usage:
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up --build -d
#
# WARNING: All placeholder values below MUST be changed before production use.
# Leaving any CHANGE_ME value will cause startup to fail (production guards are enforced).

ENVIRONMENT=production
PROJECT_NAME=FMCG ERP

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=fmcg_erp
DATABASE_URL=postgresql+asyncpg://erp_user:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/fmcg_erp
REDIS_URL=redis://redis:6379/0

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_CHAR_HEX_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["https://yourdomain.example.com"]

AUTO_CREATE_TABLES=false
RUN_MIGRATIONS_ON_STARTUP=false

# ── Seeding ────────────────────────────────────────────────────────────────────
# Set SEED_INITIAL_ADMIN=true only on first deployment to create the initial admin.
# Set to false after the first successful login to prevent accidental re-seeding.
SEED_INITIAL_ADMIN=false
SEED_DEMO_DATA=false
# SYNC_INITIAL_ADMIN_PASSWORD must be false in production — auto-syncing admin
# passwords from env is a development-only feature. Production startup rejects true.
SYNC_INITIAL_ADMIN_PASSWORD=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@yourdomain.example.com
# Use a strong unique password. This is only used when creating the initial admin.
# Never use Admin1234! or any default password in production.
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
INITIAL_ADMIN_FULL_NAME=System Administrator
DEMO_USER_PASSWORD=

# ── Auth cookies ───────────────────────────────────────────────────────────────
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_RETURN_TOKEN_IN_BODY=false
REQUEST_TIMEOUT_SECONDS=60
ERROR_TRACKING_DSN=

# ── Password policy (production enforces all) ──────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://yourdomain.example.com

# ── AI Provider ────────────────────────────────────────────────────────────────
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3
AI_NL_COMMAND_EXECUTION_ENABLED=false
